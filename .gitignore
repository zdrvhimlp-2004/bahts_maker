# Yang masuk git cuma mesin, contoh, dan berkas akar. Sisanya tetap lokal:
# - folder bahts (naskah, Word, PDF)
# - kitab/ = perpustakaan Shamela lokal (diunduh lewat `python mesin/bahts.py siapkan` dan `ambil <id>`)
# - sampul_saya.txt = data sampul pemakai
/*
!/.gitignore
!/.gitattributes
!/.github/
!/.mcp.json
!/opencode.json
!/AGENTS.md
!/CLAUDE.md
!/README.md
!/CHANGELOG.md
!/LICENSE
!/NOTICE
!/requirements.txt
!/mesin/
!/contoh/
!/dok/
/contoh/*
!/contoh/naskah.txt
# naskah jebakan: tiap baris di bawah #S menghasilkan persis yang disebut judulnya (diperiksa .github/uji_jebakan.py)
!/contoh/jebakan/
/contoh/jebakan/*
!/contoh/jebakan/naskah.txt
# bahan antara mesin, sisa Word/Python, dan font mushaf (diunduh `siapkan`, lihat NOTICE)
mesin/_tmp/
mesin/*.ttf
__pycache__/
~$*

# antarmuka grafis dan peluncurnya
!/bahts_gui.py
!/Mesin Bahts.bat
